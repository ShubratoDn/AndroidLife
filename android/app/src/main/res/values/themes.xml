<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TruckController" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/amber_400</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="colorSurface">#121821</item>
        <item name="android:windowBackground">@color/cockpit_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/cockpit_bg</item>
        <item name="android:navigationBarColor">@color/cockpit_bg</item>
    </style>

    <style name="Cockpit.Mono" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/slate_400</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Cockpit.StepButton" parent="">
        <item name="android:background">@drawable/bg_step_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">4dp</item>
        <item name="tint">@color/slate_400</item>
    </style>

    <style name="Cockpit.HeaderIcon" parent="">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:background">@drawable/bg_header_icon</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="tint">@color/slate_300</item>
    </style>

    <!-- Buttons in the Night Screen notification (follows the system notification text colour) -->
    <style name="NightButton" parent="TextAppearance.Compat.Notification">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="Cockpit.CbPreset" parent="Cockpit.Mono">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
